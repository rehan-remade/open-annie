# Copy to .env (gitignored). broker/local.py and demo/user_voice.py read it.

# Voice: an OpenAI key with GPT-Live access.
OPENAI_API_KEY=
# Decisions: a TypeSafe key for Jev (https://typesafe.ai). Without it, the local rule floor decides.
TYPESAFE_API_KEY=

# Optional broker settings (defaults in broker/annie_broker/config.py).
# ANNIE_HMAC_SECRET=            # signs session tokens; random per start when unset
# ANNIE_DAILY_BUDGET_USD=25
# ANNIE_SESSION_CAP_S=180
# ANNIE_IDLE_TIMEOUT_S=30
# ANNIE_PER_IP_DAILY=0          # local.py defaults this to 0 (no per-IP limit) for development
# ANNIE_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
